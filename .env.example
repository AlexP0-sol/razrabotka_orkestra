# ORCHESTRA Configuration Example (L0 Config & Secrets, §13.1, DoD-04)
# Copy to .env and customize. NEVER commit real secrets to git (BAN-04, SEC-01).

ORCHESTRA_PROFILE=dev
ORCHESTRA_RUNTIME_DIR=./runtime

# --- LLM Provider (L1) ---
ORCHESTRA_LLM__PROVIDER=openai_compat
ORCHESTRA_LLM__BASE_URL=https://integrate.api.nvidia.com/v1
ORCHESTRA_LLM__DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
ORCHESTRA_LLM__TEMPERATURE=0.0
ORCHESTRA_LLM__MIN_TEMPERATURE=0.0
ORCHESTRA_LLM__SEED=1337
ORCHESTRA_LLM__MAX_OUTPUT_TOKENS=16384
ORCHESTRA_LLM__REQUEST_TIMEOUT_S=180.0
ORCHESTRA_LLM__STREAM=true
ORCHESTRA_LLM__ENABLE_THINKING=true
ORCHESTRA_LLM__CACHE_ENABLED=true

# --- Key Pool (L1) ---
# Comma-separated JSON array or indexed env vars ORCHESTRA_KEY_POOL__KEYS__0=...
# Replace placeholders locally in .env; keep empty or use provider=mock for tests/demo.
ORCHESTRA_KEY_POOL__KEYS=[]
ORCHESTRA_KEY_POOL__COOLDOWN_429_S=60
ORCHESTRA_KEY_POOL__COOLDOWN_5XX_S=15
ORCHESTRA_KEY_POOL__MAX_CONSECUTIVE_FAILURES=5
ORCHESTRA_KEY_POOL__PROBE_ON_START=true
ORCHESTRA_KEY_POOL__EXCLUSIVE_LEASE=false
ORCHESTRA_KEY_POOL__MAX_CONCURRENT_PER_KEY=2

# --- Swarm & Generation (L5/L6) ---
ORCHESTRA_SWARM__MAX_CONCURRENT_AGENTS=6
ORCHESTRA_SWARM__MAX_CONCURRENT_LLM_CALLS=8
ORCHESTRA_SWARM__MAX_RETRIES_PER_NODE=2
ORCHESTRA_SWARM__MAX_AGENTS_HARD_CAP=20
ORCHESTRA_SWARM__REQUIRE_TEAM_APPROVAL=true

ORCHESTRA_GEN__MAX_CHUNK_LINES=300
ORCHESTRA_GEN__RECOMMENDED_CHUNK_LINES=200

# --- Mental Map Persistence (L3) ---
ORCHESTRA_MAP__SNAPSHOT_EVERY_EVENTS=200
ORCHESTRA_MAP__LEASE_TTL_S=600
ORCHESTRA_MAP__LEASE_HEARTBEAT_S=60

# --- Validation Sandbox (L2) ---
ORCHESTRA_SANDBOX__MODE=subprocess
ORCHESTRA_SANDBOX__TIMEOUT_S=120
ORCHESTRA_SANDBOX__MEMORY_LIMIT_MB=2048
ORCHESTRA_SANDBOX__CPU_LIMIT=1.0
ORCHESTRA_SANDBOX__NETWORK=disabled
ORCHESTRA_SANDBOX__DOCKER_IMAGE=python:3.12-slim

# --- Telegram Human Bridge (L7) ---
ORCHESTRA_TELEGRAM__ENABLED=false
ORCHESTRA_TELEGRAM__BOT_TOKEN=
# Fail-closed whitelist: empty list denies all users (TG-01)
ORCHESTRA_TELEGRAM__ALLOWED_USER_IDS=[]
ORCHESTRA_TELEGRAM__QUESTION_TIMEOUT_S=3600
ORCHESTRA_TELEGRAM__DEFAULT_ACTION=pause_node

# --- Web Dashboard (L7) ---
ORCHESTRA_WEB__ENABLED=true
ORCHESTRA_WEB__HOST=0.0.0.0
ORCHESTRA_WEB__PORT=8000
ORCHESTRA_WEB__ACCESS_TOKEN=
ORCHESTRA_WEB__FRONTEND=vanilla

# --- Platform & Multi-Exchange (v1.2) ---
ORCHESTRA_PLATFORM__ATOMIC_REPLACE_RETRIES=5
ORCHESTRA_PLATFORM__PATH_LENGTH_WARN=240
ORCHESTRA_PLATFORM__ENFORCE_LF=true

ORCHESTRA_EXCHANGES__REGISTRY_PATH=exchanges.yaml
# Fail-closed: empty list means no exchange is active by default (DP-88)
ORCHESTRA_EXCHANGES__ENABLED=[]
ORCHESTRA_EXCHANGES__ALIGN_TOLERANCE_MS=250

# --- Budgets & Reasoning ---
ORCHESTRA_BUDGETS__NODE_TOKEN_LIMIT=200000
ORCHESTRA_BUDGETS__NO_PROGRESS_ALERT_S=900

ORCHESTRA_REASONING__ARCHITECT_BUDGET=16384
ORCHESTRA_REASONING__QA_BUDGET=16384
ORCHESTRA_REASONING__DEVELOPER_BUDGET=8192
ORCHESTRA_REASONING__TRIVIAL_BUDGET=2048

# --- Telemetry ---
ORCHESTRA_TELEMETRY__LOG_LEVEL=INFO
ORCHESTRA_TELEMETRY__REDACT_SECRETS=true
